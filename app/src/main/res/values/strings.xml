    <string name="app_name">净屏助手</string>
    <string name="accessibility_service_label">净屏助手服务</string>
    <string name="accessibility_service_description">本服务在本地匹配已安装应用的界面文本，自动点击跳过开屏广告。所有数据仅保存在本机，不收集、不上传任何信息。</string>
